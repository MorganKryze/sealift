{
  "realm": "lab",
  "enabled": true,
  "clients": [
    {
      "clientId": "oauth2-proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "lab-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:18440/oauth2/callback"],
      "webOrigins": ["http://localhost:18440"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:18440/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "oauth2-proxy",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@lab.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@lab.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Lab",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}
