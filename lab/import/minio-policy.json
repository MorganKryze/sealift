{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::user-*"],
      "Condition": {"StringLike": {"s3:prefix": ["packages/npm/", "packages/npm/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::user-*/packages/npm/*"]
    }
  ]
}
